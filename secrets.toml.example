# このファイルを .streamlit/secrets.toml にコピーして、実際の値を記入してください。
#
#   cp secrets.toml.example .streamlit/secrets.toml
#
# 記入は「環境ごとに1回だけ」です。ファイルとして残るので、
# アプリを起動するたびに入力する必要はありません。
#
# .streamlit/secrets.toml は .gitignore 済みです。絶対にコミットしないでください。
# DBパスワードが漏れると、第三者が Supabase のデータを全削除できます。
#
# Streamlit Community Cloud にデプロイする場合は、このファイルを置く代わりに
# アプリ設定画面の「Secrets」欄へ同じ内容を貼り付けてください。

[db]
# Supabase ダッシュボード → Project Settings → Database → Connection string
# → 「Session pooler」タブの文字列を使ってください。
#
# 「Direct connection」(db.<ref>.supabase.co) は IPv6 専用のため、
# 環境によっては接続できません。Session pooler は IPv4 に対応しています。
url = "postgresql+psycopg2://postgres.<project-ref>:<YOUR-DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

[supabase]
# Supabase ダッシュボード → Project Settings → API Keys
# ログイン(Auth)にのみ使用します。データ操作は上の [db] 経由です。
#
# publishable_key には「Publishable key」(sb_publishable_... で始まるもの) を入れます。
# 旧 anon key の後継で、ブラウザに出る前提の公開可能なキーです。
#
# 「Secret key」(sb_secret_...) は絶対に使わないでください。
# 旧 service_role 相当で、RLS を無視して全データを読み書きできます。
#
# 古いプロジェクトで sb_publishable_ 形式が見つからない場合は、
# 「Legacy anon, service_role API keys」タブの anon key を入れても動きます。
url = "https://<project-ref>.supabase.co"
publishable_key = "<YOUR-PUBLISHABLE-KEY>"
